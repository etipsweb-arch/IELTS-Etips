# ==============================================================================
# .gitignore untuk Proyek Website IELTS-Etips (HTML, CSS, JS)
# ==============================================================================

# --- Keamanan & Lingkungan (Secrets & Credentials) ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.pem
*.key
*.pfx
*.cert
credentials.json
secrets.json

# --- Operating System Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# --- Editor & IDE Directories ---
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- Logs & Temporary Files ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Dependencies & Build Output (jika menggunakan package manager di masa depan) ---
node_modules/
dist/
build/

# --- Metadata Tooling ---
*.metadata.json

# --- Dokumen Internal / Draft Spec (Hapus '#' jika ingin dikecualikan) ---
# *.docx

*.bak
